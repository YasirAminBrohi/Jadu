{
  "name": "jadu",
  "version": "1.0.1",
  "description": "Premium AI-powered browser extension shortcut manager",
  "main": "dist/background.js",
  "scripts": {
    "dev": "npm run build && vite",
    "build:ui": "vite build",
    "build:content": "vite build --config vite.config.content.ts && vite build --config vite.config.background.ts",
    "build": "npm run build:ui && npm run build:content",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "framer-motion": "^11.0.8",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.260",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.4"
  }
}
